{
	"name": "roguenode",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.9 <25"
	},
	"scripts": {
		"dev": "npm-run-all --parallel dev:frontend dev:backend",
		"dev:frontend": "next dev",
		"dev:backend": "convex dev",
		"predev": "convex dev --until-success && convex dashboard",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"test": "vitest run",
		"lint:fix": "eslint . --fix && biome check --write .",
		"planning:prompt": "node scripts/generate-pddl-llm.mjs",
		"planning:refresh": "node scripts/run-planning.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai": "^2.0.32",
		"@clerk/nextjs": "^7.0.1",
		"@convex-dev/agent": "^0.2.10",
		"ai": "^5.0.48",
		"convex": "^1.27.1",
		"lucide-react": "^0.544.0",
		"next": "16.1.6",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@convex-dev/eslint-plugin": "0.0.1-alpha.4",
		"@eslint/eslintrc": "^3.3.1",
		"@tailwindcss/postcss": "^4.1.13",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.0",
		"@types/node": "^20.19.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.36.0",
		"eslint-config-next": "16.1.6",
		"jsdom": "28.1.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.6.2",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vitest": "^4.0.18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@tailwindcss/oxide"
		]
	}
}
